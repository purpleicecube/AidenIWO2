# IWO3 local development env
# Copy to /home/virgina/VS_AIDEN_IWO3/.env and adjust.
# Never commit .env. gitleaks + .gitignore enforce this.

# --- Database (see docker-compose.iwo3-postgres.yml)
IWO3_PG_USER=iwo3
IWO3_PG_PASSWORD=iwo3

# Two explicit local-DB lanes (Test DB Split Darkmode 2026-05-10):
#
#   IWO3_DATABASE_URL       -> local-live  (operator app/dev DB; allowed
#                              to drift; safe to click around in)
#   IWO3_TEST_DATABASE_URL  -> local-test-fresh  (disposable; reset+
#                              reseeded by `npm run test:integration`;
#                              safe to destroy)
#
# Both URLs may share the same Postgres host:port; only the database
# name differs. The wrapper script `infra/local/test-integration-iwo3.sh`
# refuses to run unless the test URL's DB name ends with `_test`.
IWO3_DATABASE_URL=postgresql://iwo3:iwo3@localhost:5434/aiden_iwo3
IWO3_TEST_DATABASE_URL=postgresql://iwo3:iwo3@localhost:5434/aiden_iwo3_test

# --- Runtime
NODE_ENV=development

# --- Credential references (use credential_ref: placeholders here; real
#     secrets live in a secret manager per ADR-002 / CODEX §9)
# GAMMA_API_KEY=credential_ref:dev-local-gamma-01
# ANTHROPIC_API_KEY=credential_ref:dev-local-anthropic-01
# OPENAI_API_KEY=credential_ref:dev-local-openai-01
